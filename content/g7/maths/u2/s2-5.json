   "id": "math.integer-multiplication-properties",
   "name": "Properties of multiplication",
   "explain": {
    "en": {
     "text": "Multiplication of integers is commutative and associative. It also distributes over addition: a times b plus c equals a times b plus a times c. Any integer times zero is zero, and any integer times one is itself."
    }
   },
