   "name": "Multiplying two integers",
   "requires": [
    "math.add-integers-rules"
   ],
   "explain": {
    "en": {
     "text": "Multiplication is repeated addition: 4 times minus 5 is minus 5 added four times, which is minus 20. Same signs give a positive product. Different signs give a negative product. Multiply the sizes, then put the sign in front."
    }
   },
