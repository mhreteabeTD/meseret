   "id": "math.subtract-integers",
   "name": "Subtracting integers",
   "requires": [
    "math.add-integers-rules"
   ],
   "explain": {
    "en": {
     "text": "Subtracting an integer is the same as adding its opposite: a minus b equals a plus minus b. So 4 minus 7 is 4 plus minus 7, which is minus 3. Subtracting a negative number is the same as adding a positive one: 25 minus minus 30 is 55."
    }
   },
   "screens": [
