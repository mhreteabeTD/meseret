 "ideas": [
  {
   "id": "sci.criss-cross",
   "name": "Writing formulas by criss-cross",
   "explain": {
    "en": {
     "text": "A binary compound has two different elements. To write its formula: write the symbols, write each valence above, then criss-cross the valences to below the other symbol. Omit a subscript of 1. Calcium (2) and chlorine (1) give CaCl₂."
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "How many partners?",
     "ask": "Calcium has valence 2 and chlorine has valence 1. How many chlorines does one calcium need?",
     "opts": [
      "1",
      "2",
      "3"
     ],
     "after": "Calcium can hold two chlorines. The formula is CaCl₂. The criss-cross method shows this.",
     "ref": "Example b",
     "id": "g7.science.u3.s3-2-4.1"
    },
    {
     "kind": "read",
     "step": "read",
     "title": "3.2.4 Formulas of binary compounds",
     "paras": [
      "Binary compounds are made of two different elements.",
      "To write their formulas, follow three steps."
     ],
     "table": [
      [
       "Step",
       "What to do"
      ],
      [
       "i",
       "Write the symbols of the elements."
      ],
      [
       "ii",
       "Write the valence number above each symbol."
      ],
      [
       "iii",
       "Criss-cross the valences and write them below the symbols. Omit a 1."
      ]
     ],
     "id": "g7.science.u3.s3-2-4.2"
    },
    {
     "kind": "steps",
     "step": "method",
     "title": "Example a: potassium iodide",
     "steps": [
      "Step 1: write the symbols K and I.",
      "Step 2: valences above: K is 1, I is 1.",
      "Step 3: criss-cross: K₁I₁.",
      "A subscript of 1 is omitted. Potassium iodide is KI."
     ],
     "id": "g7.science.u3.s3-2-4.3"
    },
    {
     "kind": "steps",
     "step": "method",
     "title": "Example b: calcium chloride",
     "steps": [
      "Step 1: write the symbols Ca and Cl.",
      "Step 2: valences above: Ca is 2, Cl is 1.",
      "Step 3: criss-cross: Ca gets 1, Cl gets 2 → Ca₁Cl₂.",
      "Omit the 1. Calcium chloride is CaCl₂."
     ],
     "id": "g7.science.u3.s3-2-4.4"
    },
