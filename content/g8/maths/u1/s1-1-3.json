  {
   "id": "math.absolute-value-equation",
   "name": "Absolute value equations",
   "explain": {
    "en": {
     "text": "|x| = 8 asks: which numbers are 8 units from zero? There are two, 8 and −8. If a is positive, |x| = a has two solutions. If a is zero, there is one solution, 0. If a is negative, there is no solution, because a distance cannot be negative."
    },
    "am": {
     "text": "|x| = 8 ከዜሮ 8 ርቀት ላይ ያሉት ቁጥሮች የትኞቹ ናቸው ብሎ ይጠይቃል። ሁለት ናቸው፤ 8 እና −8። a አዎንታዊ ከሆነ ሁለት መፍትሔ፣ ዜሮ ከሆነ አንድ፣ አሉታዊ ከሆነ ምንም መፍትሔ የለም።",
     "machine": true
    }
   },
