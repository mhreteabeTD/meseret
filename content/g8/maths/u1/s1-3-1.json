  {
   "id": "math.addition-properties",
   "name": "Properties of addition",
   "explain": {
    "en": {
     "text": "Addition is commutative: the order does not matter. It is associative: the grouping does not matter. Adding 0 changes nothing. A number plus its opposite is 0."
    },
    "am": {
     "text": "መደመር የመለዋወጥ ባሕሪ አለው፤ ቅደም ተከተሉ ለውጥ አያመጣም። የመቧደን ባሕሪም አለው። 0 መደመር ምንም አይለውጥም። ቁጥርና ተቃራኒው ሲደመሩ 0 ይሆናል።",
     "machine": true
    }
   },
