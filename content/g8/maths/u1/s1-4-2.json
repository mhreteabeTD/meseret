    {
     "kind": "steps",
     "step": "method",
     "title": "Abebe's loan",
     "steps": [
      "Write what you know: P = Birr 21100, R = 15%, T = 5 months.",
      "Change the rate to a decimal: 15% = 15 ÷ 100 = 0.15.",
      "Change the time to years: 5 months = 5/12 of a year (a year has 12 months).",
      "I = P × R × T = 21100 × 0.15 × 5/12.",
      "21100 × 0.15 = 3165.",
      "3165 × 5 = 15825, and 15825 ÷ 12 = 1318.75.",
      "Abebe pays Birr 1318.75 interest."
     ],
     "id": "g8.maths.u1.s1-4-2.5",
     "ref": "Example 1.35"
