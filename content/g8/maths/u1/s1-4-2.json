    {
     "kind": "steps",
     "step": "method",
     "title": "Find P",
     "steps": [
      "Write what you know: I = Birr 250, R = 10%, T = 2 1/2 years.",
      "R = 10% = 10 ÷ 100 = 0.1. T = 2 1/2 = 2.5 years.",
      "I = P × R × T, so P = I ÷ (R × T).",
      "R × T = 0.1 × 2.5 = 0.25.",
      "P = 250 ÷ 0.25 = 1000.",
      "The principal is Birr 1000."
     ],
