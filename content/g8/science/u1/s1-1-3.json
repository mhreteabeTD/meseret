   "id": "sci.prefixes",
   "name": "Prefixes",
   "explain": {
    "en": {
     "text": "A prefix is a short way to write very large or very small amounts: mega (M) = 1 000 000, kilo (k) = 1000, centi (c) = 0.01, milli (m) = 0.001, micro (µ) = 0.000001. So 1 km = 1000 m and 1 mm = 0.001 m."
    },
    "am": {
     "text": "ቅድመ ቅጥያ ትልቅና ትንሽ መጠኖችን በአጭሩ ለመጻፍ ይረዳል፤ ኪሎ = 1000፣ ሴንቲ = 0.01፣ ሚሊ = 0.001።",
     "machine": true
    }
   },
