  "keywords": [
    {
      "en": "Absolute value",
      "am": "ፍጹም ዋጋ",
      "machine": true,
      "def": "The distance of a number from 0 on the number line: |x| is never negative."
    },
    {
      "en": "Distance between a and b",
      "am": "በ a እና b መካከል ያለ ርቀት",
      "machine": true,
      "def": "The distance between two real numbers a and b is |a − b|, and |a − b| = |b − a|."
    }
  ],
  "ideas": [
    {
      "id": "math.absolute-value",
      "name": "Absolute value",
      "requires": [
        "math.integer-subtraction"
      ],
      "explain": {
        "en": {
          "text": "The absolute value of x, written |x|, is its distance from 0. It is never negative. If x is 0 or positive, |x| = x. If x is negative, |x| = −x. The distance between a and b is |a − b|."
        },
        "am": {
          "text": "የ x ፍጹም ዋጋ |x| ተብሎ ይጻፋል። ከዜሮ ያለው ርቀት ነው፤ አሉታዊ አይሆንም። x አዎንታዊ ወይም ዜሮ ከሆነ |x| = x ነው። x አሉታዊ ከሆነ |x| = −x ነው። በ a እና b መካከል ያለው ርቀት |a − b| ነው።",
          "machine": true
        }
      },
      "screens": [
        {
          "kind": "guess",
          "step": "hook",
          "added": true,
          "title": "Who walked farther?",
          "text": "Bekele walks 3 km west of Meskel Square. Tigist walks 3 km east of it. Call east positive: Bekele is at −3, Tigist at 3.",
          "ask": "Who is farther from Meskel Square?",
          "opts": [
            "Bekele",
            "Tigist",
            "They are the same distance",
            "We cannot tell"
          ],
          "after": "Distance does not care about direction. The book calls it absolute value."
        },
        {
          "kind": "read",
          "step": "read",
          "title": "Definition 1.8",
          "paras": [
            "The absolute value of a real number x is written |x|.",
            "|x| = x if x ≥ 0, and |x| = −x if x < 0.",
            "It is the distance of x from 0. So it is never negative."
          ]
        },
        {
          "kind": "name",
          "step": "name",
          "title": "Absolute value",
          "defs": [
            [
              "Absolute value",
              "|x| is the distance of x from 0. |x| = x if x ≥ 0, and |x| = −x if x < 0."
