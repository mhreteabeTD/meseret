  {
   "id": "chem.ph-poh",
   "name": "pH and pOH",
   "requires": [],
   "explain": {
    "en": {
     "text": "Because [H₃O⁺] is often tiny, we use pH = −log[H₃O⁺] and pOH = −log[OH⁻]. The reverse is [H₃O⁺] = 10^(−pH). At 25 °C pH + pOH = 14. Neutral is pH 7, acidic below 7, basic above 7. A lower pH means more H₃O⁺, and pH can even be below 0 or above 14."
    },
    "am": {
     "text": "pH = −log[H₃O⁺]፣ pOH = −log[OH⁻]። በ25 °C pH + pOH = 14። ከ7 በታች አሲዳማ፣ ከ7 በላይ ቤዛማ ነው።",
     "machine": true
    }
   },
