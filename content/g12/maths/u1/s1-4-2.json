 "ideas": [
  {
   "id": "math.recurring-decimals",
   "name": "Recurring decimals as fractions",
   "requires": [
    "math.infinite-geometric-series"
   ],
   "explain": {
    "en": {
     "text": "A recurring decimal is an infinite geometric series. 0.474747… = 47/100 + 47/10000 + … with r = 1/100, so it equals (47/100)/(99/100) = 47/99. The quick rule: the repeating digits over as many 9s as there are repeating digits. Add any whole-number part separately."
    },
    "am": {
     "text": "ተደጋጋሚ አስርዮሽ ኢውሱን ጂኦሜትሪክ ተከታታይ ድምር ነው። 0.4747… = 47/99። የሚደጋገሙትን አሃዞች በዚያው ብዛት 9ዎች ላይ እንጽፋለን።",
     "machine": true
    }
   },
   "screens": [
