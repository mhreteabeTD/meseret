    {
     "kind": "steps",
     "step": "method",
     "title": "0.474747… as a fraction",
     "steps": [
      "0.474747… = 47/100 + 47/10000 + 47/1000000 + …",
      "G₁ = 47/100 and r = 1/100.",
      "S∞ = (47/100)/(1 − 1/100) = (47/100)/(99/100).",
      "= 47/100 × 100/99 = 47/99."
     ],
     "ref": "Example 2",
