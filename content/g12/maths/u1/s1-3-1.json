     "paras": [
      "If every term is c, the sum of n terms is nc. In particular ∑ 1 = n."
     ],
     "table": [
      [
       "Property",
       "Rule"
      ],
      [
       "(1) Constant multiple",
       "∑ c·aₖ = c ∑ aₖ"
      ],
      [
       "(2) Sum",
       "∑ (aₖ + bₖ) = ∑ aₖ + ∑ bₖ"
      ],
      [
       "(3) Difference",
       "∑ (aₖ − bₖ) = ∑ aₖ − ∑ bₖ"
      ],
      [
       "(4) Split",
       "∑ₖ₌₁ⁿ aₖ = ∑ₖ₌₁ᵐ aₖ + ∑ₖ₌ₘ₊₁ⁿ aₖ"
      ]
