    "am": {
     "text": "በጂኦሜትሪክ ቅደም ተከተል በየጊዜው በአንድ አይነት ዜሮ ያልሆነ ቁጥር እናባዛለን። ይህ ቁጥር የጋራ ሬሾ r ይባላል፤ r = ቀጣዩ ተርም ÷ ይህ ተርም።",
     "machine": true
    }
   },
