   "explain": {
    "en": {
     "text": "Multiply the sum by r and subtract: all the middle terms cancel and (1 − r)Sₙ = G₁(1 − rⁿ). So Sₙ = G₁(1 − rⁿ)/(1 − r) when r ≠ 1, and Sₙ = nG₁ when r = 1."
    },
    "am": {
     "text": "ድምሩን በ r አባዝተን ስንቀንስ መካከለኛዎቹ ተርሞች ይሰረዛሉ። ስለዚህ r ≠ 1 ሲሆን Sₙ = G₁(1 − rⁿ)/(1 − r)፤ r = 1 ሲሆን Sₙ = nG₁።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Doubling sums",
     "ask": "2 + 4 + 8 + 16 + 32 = ?",
     "opts": [
      "62",
      "64",
      "60",
      "32"
     ],
     "after": "62. Notice 62 = 64 − 2 = 2(2⁵ − 1). Geometric sums have a pattern like this.",
     "ref": "Activity 1.6 Q1 a",
     "id": "g12.maths.u1.s1-3-3.1"
    },
    {
     "kind": "steps",
     "step": "method",
     "title": "Multiply by r and subtract",
     "steps": [
      "Sₙ = G₁(1 + r + r² + … + rⁿ⁻¹).",
      "rSₙ = G₁(r + r² + … + rⁿ⁻¹ + rⁿ).",
      "Subtract: the middle terms cancel. Sₙ − rSₙ = G₁(1 − rⁿ).",
      "(1 − r)Sₙ = G₁(1 − rⁿ).",
      "Divide by 1 − r (only if r ≠ 1): Sₙ = G₁(1 − rⁿ)/(1 − r)."
     ],
     "ref": "p.32",
     "id": "g12.maths.u1.s1-3-3.2"
    },
    {
     "kind": "read",
     "step": "read",
     "title": "Theorem 1.4",
     "paras": [
      "If r = 1, every term is G₁, so Sₙ = nG₁.",
      "If r ≠ 1, Sₙ = G₁(1 − rⁿ)/(1 − r) = G₁(rⁿ − 1)/(r − 1)."
     ],
     "note": "Use (rⁿ − 1)/(r − 1) when r > 1: the signs stay positive.",
     "ref": "Theorem 1.4",
     "id": "g12.maths.u1.s1-3-3.3"
    },
    {
     "kind": "slider",
     "step": "explore",
     "added": true,
     "title": "Watch the sum grow",
     "ask": "Change r and n. Compare r = 2 with r = 0.5.",
     "vars": [
      {
       "k": "g",
       "label": "G₁",
       "min": 1,
       "max": 10,
       "step": 1,
       "v": 1
      },
      {
       "k": "r",
       "label": "r",
       "min": -2,
       "max": 3,
       "step": 0.5,
       "v": 0.5
      },
      {
       "k": "n",
       "label": "n",
       "min": 1,
       "max": 20,
       "step": 1,
       "v": 5
