  {
   "id": "math.gauss-sum",
   "name": "Sum of the first n natural numbers",
   "requires": [],
   "explain": {
    "en": {
     "text": "Write the sum forwards and backwards and add: every pair makes n + 1, and there are n pairs. So twice the sum is n(n + 1), and 1 + 2 + … + n = n(n + 1)/2."
    },
    "am": {
     "text": "ድምሩን ወደፊትና ወደኋላ ጽፈን ስንደምር እያንዳንዱ ጥንድ n + 1 ይሆናል፤ n ጥንዶች አሉ። ስለዚህ 1 + 2 + … + n = n(n + 1)/2።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Gauss at school",
     "ask": "Young Gauss added 1 + 2 + 3 + … + 100 in a few moments. What is the sum?",
     "opts": [
      "5000",
      "5050",
      "10100",
      "4950"
     ],
     "after": "5050. He paired 1 + 100, 2 + 99, … : each pair is 101.",
     "ref": "Historical note",
     "id": "g12.maths.u1.s1-3-2.1"
    },
    {
     "kind": "people",
     "step": "read",
     "title": "Carl Friedrich Gauss",
     "people": [
      {
       "name": "Carl Friedrich Gauss",
       "years": "1777–1855",
       "from": "Germany",
       "did": "As a schoolboy he added 1 to 100 in moments by pairing the numbers.",
       "img": "https://commons.wikimedia.org/wiki/Special:FilePath/Carl_Friedrich_Gauss_1840_by_Jensen.jpg?width=240"
      }
     ],
     "id": "g12.maths.u1.s1-3-2.2"
    },
    {
     "kind": "steps",
     "step": "method",
     "title": "Forwards and backwards",
     "steps": [
      "S = 1 + 2 + 3 + … + 100.",
      "S = 100 + 99 + 98 + … + 1.",
      "Add the two lines: each column is 101.",
      "2S = 100 × 101, so S = 5050.",
      "In general 2Sₙ = n(n + 1), so Sₙ = n(n + 1)/2."
     ],
     "ref": "p.26–27",
     "id": "g12.maths.u1.s1-3-2.3"
