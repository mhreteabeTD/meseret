  {
   "id": "math.arithmetic-series",
   "name": "Sum of an arithmetic sequence",
   "requires": [
    "math.arithmetic-nth-term"
   ],
   "explain": {
    "en": {
     "text": "For an arithmetic sequence Sₙ = (n/2)[2A₁ + (n − 1)d]. When you know the first and last terms, use Sₙ = n(A₁ + Aₙ)/2: the number of terms times the average of the ends."
    },
    "am": {
     "text": "የአሪትሜቲክ ቅደም ተከተል ድምር Sₙ = (n/2)[2A₁ + (n − 1)d] ነው። የመጀመሪያውንና የመጨረሻውን ተርም ካወቅን Sₙ = n(A₁ + Aₙ)/2።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Pairing again",
     "ask": "5, 15, 25, …, 95 has 10 terms. What is the sum?",
     "opts": [
      "500",
      "1000",
      "950",
      "100"
     ],
     "after": "5 + 95 = 100, 15 + 85 = 100, … Five pairs of 100 make 500.",
     "ref": "Activity 1.5",
     "id": "g12.maths.u1.s1-3-2.11"
    },
    {
     "kind": "read",
     "step": "read",
     "title": "Theorem 1.3",
     "paras": [
      "Sₙ = (n/2)[2A₁ + (n − 1)d].",
      "Also Sₙ = n(A₁ + Aₙ)/2, where Aₙ is the last term.",
      "The second form is useful when the first and last terms are known."
     ],
     "ref": "Theorem 1.3",
     "id": "g12.maths.u1.s1-3-2.12"
    },
    {
     "kind": "steps",
     "step": "method",
     "title": "Where the formula comes from",
     "steps": [
      "Sₙ = A₁ + (A₁ + d) + … + (A₁ + (n − 1)d).",
      "Collect the n copies of A₁: Sₙ = nA₁ + d[1 + 2 + … + (n − 1)].",
      "1 + 2 + … + (n − 1) = (n − 1)n/2.",
      "So Sₙ = nA₁ + n(n − 1)d/2 = (n/2)[2A₁ + (n − 1)d]."
     ],
     "ref": "p.27–28",
     "id": "g12.maths.u1.s1-3-2.13"
    },
    {
     "kind": "name",
     "step": "name",
     "title": "Key words",
     "defs": [
      [
       "Arithmetic series",
       "The sum of the terms of an arithmetic sequence."
      ]
     ],
     "id": "g12.maths.u1.s1-3-2.14"
    },
