  {
   "id": "math.sequence-convergence",
   "name": "Convergence of rⁿ",
   "requires": [],
   "explain": {
    "en": {
     "text": "As n grows, rⁿ goes to infinity when r > 1, stays 1 when r = 1, shrinks to 0 when −1 < r < 1, and jumps without a limit when r ≤ −1. A negative r between −1 and 0 still goes to 0: the signs flip but the size shrinks."
    },
    "am": {
     "text": "n ሲያድግ፤ r > 1 ሲሆን rⁿ ወደ ኢንፊኒቲ ይሄዳል፤ r = 1 ሲሆን 1 ይቀራል፤ −1 < r < 1 ሲሆን ወደ 0 ይቀርባል፤ r ≤ −1 ሲሆን ወሰን የለውም።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
