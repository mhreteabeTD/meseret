    "am": {
     "text": "n ሲያድግ፤ r > 1 ሲሆን rⁿ ወደ ኢንፊኒቲ ይሄዳል፤ r = 1 ሲሆን 1 ይቀራል፤ −1 < r < 1 ሲሆን ወደ 0 ይቀርባል፤ r ≤ −1 ሲሆን ወሰን የለውም።",
     "machine": true
    }
