  {
   "id": "math.infinite-geometric-series",
   "name": "Sum of an infinite geometric series",
   "requires": [
    "math.geometric-series"
   ],
   "explain": {
    "en": {
     "text": "An infinite series converges when its partial sums Sₙ get closer to a number s. For a geometric series with |r| < 1, rⁿ → 0, so Sₙ → G₁/(1 − r). If |r| ≥ 1 there is no sum. To use the formula, rewrite the term as G₁ rᵏ⁻¹."
    },
    "am": {
     "text": "ኢንፊኒት ጂኦሜትሪክ ተከታታይ |r| < 1 ሲሆን ድምር አለው፤ S∞ = G₁/(1 − r)። |r| ≥ 1 ከሆነ ድምር የለም።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Adding forever",
     "ask": "What does 1/2 + 1/4 + 1/8 + 1/16 + … add up to?",
     "opts": [
      "∞",
      "1",
      "2",
      "1/2"
