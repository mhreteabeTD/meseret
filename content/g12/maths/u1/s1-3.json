  {
   "id": "math.sigma-notation",
   "name": "Sigma notation",
   "requires": [],
   "explain": {
    "en": {
     "text": "Sigma ∑ writes a long sum in short form. ∑ from k = m to n of aₖ means: put k = m, m + 1, …, n into aₖ and add. There are n − m + 1 terms. Renaming the index or shifting it carefully does not change the sum."
    },
    "am": {
     "text": "ሲግማ ∑ ረጅም ድምርን በአጭሩ ይጽፋል። ከ k = m እስከ n ያሉትን እሴቶች በ aₖ ውስጥ አስገብተን እንደምራለን። ተርሞቹ n − m + 1 ናቸው።",
     "machine": true
    }
   },
   "screens": [
