  {
   "id": "math.partial-sum",
   "name": "Partial sums",
   "requires": [],
   "explain": {
    "en": {
     "text": "A partial sum Sₙ adds the first n terms of a sequence: Sₙ = a₁ + a₂ + … + aₙ. Some sums telescope: when each term is a difference like 1/n − 1/(n + 1), the middle parts cancel and only the first and last parts remain."
    },
    "am": {
     "text": "ከፊል ድምር Sₙ የመጀመሪያዎቹን n ተርሞች ይደምራል። አንዳንድ ድምሮች ይታጠፋሉ (ቴሌስኮፒንግ)፤ መካከለኛዎቹ ይሰረዛሉ።",
     "machine": true
    }
   },
   "screens": [
