    "am": {
     "text": "n-ኛውን ተርም ለማግኘት ከ A₁ ተነስተን d ን (n − 1) ጊዜ እንደምራለን፤ Aₙ = A₁ + (n − 1)d።",
     "machine": true
    }
   },
