  {
   "id": "math.arithmetic-mean",
   "name": "Arithmetic means",
   "requires": [],
   "explain": {
    "en": {
     "text": "The terms between two given terms of an arithmetic sequence are arithmetic means. One mean between a and b is (a + b)/2. To insert k means between a and b, there are k + 2 terms, so b = a + (k + 1)d."
    },
    "am": {
     "text": "በሁለት ቁጥሮች መካከል ያሉት የአሪትሜቲክ ቅደም ተከተል ተርሞች የአሪትሜቲክ አማካዮች ይባላሉ። አንድ አማካይ (a + b)/2 ነው።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "The middle number",
     "ask": "1, x, 8 is arithmetic. What is x?",
     "opts": [
      "9/2",
      "4",
      "7",
