  {
   "id": "math.arithmetic-two-terms",
   "name": "Finding A₁ and d from two terms",
   "requires": [
    "math.simultaneous-equations"
   ],
   "explain": {
    "en": {
     "text": "If you know two terms, write each one as A₁ + (k − 1)d. Subtract the two equations: A₁ cancels and you get d. Then put d back to find A₁. To test whether a rule is arithmetic, work out aₙ₊₁ − aₙ; if no n is left, it is arithmetic."
    },
    "am": {
     "text": "ሁለት ተርሞች ከተሰጡ እያንዳንዱን በ A₁ + (k − 1)d መልክ እንጽፋለን። ሁለቱን እኩልታዎች ስንቀንስ A₁ ይጠፋል፤ d እናገኛለን።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Between two terms",
     "ask": "An arithmetic sequence has A₃ = 10 and A₆ = 1. How many jumps of d are there from A₃ to A₆?",
     "opts": [
      "3",
      "6",
      "9",
      "2"
     ],
     "after": "From term 3 to term 6 there are 3 jumps. They change 10 into 1, a change of −9. So d = −9 ÷ 3 = −3.",
     "id": "g12.maths.u1.s1-2-1.22"
    },
    {
     "kind": "steps",
     "step": "method",
     "title": "A₃ = 10 and A₆ = 1",
     "steps": [
      "A₃ = A₁ + 2d, so A₁ + 2d = 10.",
      "A₆ = A₁ + 5d, so A₁ + 5d = 1.",
      "Subtract: (A₁ + 5d) − (A₁ + 2d) = 1 − 10, so 3d = −9 and d = −3.",
      "A₁ + 2(−3) = 10, so A₁ = 16.",
      "Aₙ = 16 + (n − 1)(−3) = 19 − 3n.",
      "A₈ = 19 − 24 = −5."
     ],
     "ref": "Example 1",
     "id": "g12.maths.u1.s1-2-1.23"
    },
    {
     "kind": "read",
     "step": "read",
     "title": "Is it arithmetic?",
     "paras": [
      "Work out aₙ₊₁ − aₙ.",
      "If the answer has no n, the difference is constant: arithmetic.",
      "If n is left, the difference changes: not arithmetic."
     ],
