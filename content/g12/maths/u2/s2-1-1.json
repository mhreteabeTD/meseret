   "id": "math.average-rate",
   "name": "Average rate of change",
   "requires": [],
   "explain": {
    "en": {
     "text": "The average rate of change of f on [a, b] is (f(b) − f(a))/(b − a). For distance and time it is the average velocity. A straight line has the same average rate everywhere; a curve does not."
    },
    "am": {
     "text": "የ f አማካይ የለውጥ መጠን በ [a, b] ላይ (f(b) − f(a))/(b − a) ነው።",
     "machine": true
    }
   },
