  {
   "id": "math.rate-of-change",
   "name": "Rate of change",
   "requires": [],
   "explain": {
    "en": {
     "text": "A rate of change tells how much one quantity changes for each unit of another: change in output ÷ change in input. From two points it is (y₂ − y₁)/(x₂ − x₁). It can be positive (rising), negative (falling), zero (flat) or undefined (a vertical line)."
    },
    "am": {
     "text": "የለውጥ መጠን አንዱ መጠን ለሌላው እያንዳንዱ ምድብ ምን ያህል እንደሚለወጥ ይነግራል፤ (y₂ − y₁)/(x₂ − x₁)።",
     "machine": true
    }
   },
