  {
   "id": "math.instantaneous-rate",
   "name": "Instantaneous rate of change",
   "requires": [],
   "explain": {
    "en": {
     "text": "The instantaneous rate of change at x₀ is what (f(x₀ + h) − f(x₀))/h approaches as h gets closer and closer to 0. Method: expand f(x₀ + h), cancel the constant terms, divide by h, then let h go to 0."
    },
    "am": {
     "text": "በ x₀ ላይ ያለው ቅጽበታዊ የለውጥ መጠን h ወደ 0 ሲቀርብ (f(x₀ + h) − f(x₀))/h የሚቀርበው ቁጥር ነው።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Shrink the interval",
     "ask": "For y = x³ the average rate from x = 1 to 1.1 is 3.31, and from 1 to 1.001 it is 3.003001. What does it approach?",
     "opts": [
      "3",
      "3.3",
      "1",
      "0"
     ],
     "after": "As the interval shrinks, the average rate gets closer and closer to 3. That is the rate at the instant x = 1.",
     "ref": "Activity 2.2",
     "id": "g12.maths.u2.s2-1-1.19"
    },
    {
     "kind": "slider",
     "step": "explore",
     "added": true,
     "title": "Shrink h",
     "ask": "Move h towards 0. Watch ((1 + h)³ − 1)/h.",
     "vars": [
