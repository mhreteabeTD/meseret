     ],
     "why": "(6(1 + h)² − 3 − 3)/h = (12h + 6h²)/h = 12 + 6h → 12.",
     "clue": "Expand (1 + h)², cancel, divide by h.",
     "num": true,
     "graded": true,
     "level": 1,
     "step": "check",
     "ref": "Exercise 2.3 Q1",
     "id": "g12.maths.u2.s2-1-1.24"
