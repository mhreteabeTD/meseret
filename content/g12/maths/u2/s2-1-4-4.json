  {
   "id": "math.chain-rule",
   "name": "The chain rule",
   "requires": [
    "math.power-rule"
   ],
   "explain": {
    "en": {
     "text": "For a function inside a function, f(g(x)): differentiate the outside at the inside, then multiply by the derivative of the inside. (f ∘ g)′(x) = f′(g(x)) · g′(x). Forgetting the inner derivative is the most common mistake."
    },
    "am": {
     "text": "ለፋንክሽን ውስጥ ያለ ፋንክሽን፡ የውጪውን ዴሪቫቲቭ በውስጡ ላይ፣ በውስጠኛው ዴሪቫቲቭ እናባዛለን። (f ∘ g)′ = f′(g(x)) · g′(x)።",
     "machine": true
    }
   },
