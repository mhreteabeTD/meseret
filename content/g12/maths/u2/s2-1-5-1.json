 "ideas": [
  {
   "id": "math.increasing-decreasing",
   "name": "Increasing and decreasing functions",
   "requires": [
    "math.sum-rule"
   ],
   "explain": {
    "en": {
     "text": "A function is increasing where its graph rises from left to right (f′ ≥ 0) and decreasing where it falls (f′ ≤ 0). Critical numbers are where f′ = 0 or f′ does not exist, inside the domain. Mark them on a sign chart of f′ to see where f rises and falls."
    },
    "am": {
     "text": "ፋንክሽን f′ ≥ 0 በሆነበት ይጨምራል፣ f′ ≤ 0 በሆነበት ይቀንሳል። ወሳኝ ቁጥሮች f′ = 0 ወይም f′ የሌለበት ናቸው።",
     "machine": true
    }
   },
