 "ideas": [
  {
   "id": "math.tangent-normal",
   "name": "Tangent and normal lines",
   "requires": [
    "math.derivative-at-point"
   ],
   "explain": {
    "en": {
     "text": "The tangent at x = a has slope f′(a): y = f′(a)(x − a) + f(a). The normal is perpendicular, slope −1/f′(a). If f′(a) = 0 the tangent is horizontal and the normal is the vertical line x = a. A vertical tangent can occur where f′ is undefined because its denominator becomes 0."
    },
    "am": {
     "text": "በ x = a ላይ ያለው ታንጀንት ስሎፕ f′(a) አለው፤ y = f′(a)(x − a) + f(a)። ኖርማሉ ቀጥ ያለ ነው፣ ስሎፑ −1/f′(a)።",
     "machine": true
    }
   },
