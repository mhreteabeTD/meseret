 "ideas": [
  {
   "id": "math.gradient-at-point",
   "name": "Gradient at a point",
   "requires": [],
   "explain": {
    "en": {
     "text": "Move the second point Q towards P: the secant lines turn into the tangent line. So the gradient at a is what (f(x) − f(a))/(x − a) approaches as x approaches a. Factor (difference of squares or cubes) or rationalise, cancel x − a, then put x = a. For y = x² the gradient is 2a."
    },
    "am": {
     "text": "ሁለተኛውን ነጥብ Q ወደ P ስናቀርብ ሴካንቶቹ ታንጀንት ይሆናሉ። በ a ላይ ያለው ግራዲየንት x ወደ a ሲቀርብ (f(x) − f(a))/(x − a) የሚቀርበው ነው። ለ y = x² ግራዲየንቱ 2a ነው።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Secants that turn",
     "ask": "Q moves along a curve closer and closer to P. The secant line PQ becomes",
     "opts": [
