   "id": "math.first-derivative-test",
   "name": "The first derivative test",
   "requires": [
    "math.increasing-decreasing"
   ],
   "explain": {
    "en": {
     "text": "At a critical number c look at the sign of f′ on each side. − to + means a relative minimum; + to − means a relative maximum; no change means neither. The value is f(c); the place is x = c."
    },
    "am": {
     "text": "በወሳኝ ቁጥር c ዙሪያ የ f′ ምልክትን እንመለከታለን፤ ከ − ወደ + ዝቅተኛ፣ ከ + ወደ − ከፍተኛ።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Valley or hill?",
     "ask": "f′ is negative just left of c and positive just right of c. At c the graph has",
     "opts": [
      "a valley (minimum)",
      "a hill (maximum)",
      "nothing special",
      "a jump"
     ],
     "after": "Falling then rising: a valley. That is a relative minimum.",
     "id": "g12.maths.u2.s2-1-5-2.10"
    },
    {
     "kind": "read",
     "step": "read",
     "title": "First derivative test",
     "paras": [
