   "id": "math.quotient-rule",
   "name": "The quotient rule",
   "requires": [
    "math.power-rule"
   ],
   "explain": {
    "en": {
     "text": "For a quotient: (f/g)′ = (f′g − fg′)/g², with g ≠ 0. Keep the order on top (bottom times top′ first, i.e. f′g − fg′) and square the bottom. For 1/g: (1/g)′ = −g′/g²."
    },
    "am": {
     "text": "ለክፍልፋይ፡ (f/g)′ = (f′g − fg′)/g²። ለ 1/g፡ (1/g)′ = −g′/g²።",
     "machine": true
    }
   },
