   "id": "math.power-rule",
   "name": "The power rule",
   "requires": [],
   "explain": {
    "en": {
     "text": "To differentiate xⁿ, bring the power down and reduce it by 1: (xⁿ)′ = n xⁿ⁻¹. It works for negative powers too, and with a constant in front: (kxⁿ)′ = knxⁿ⁻¹. Rewrite 1/xⁿ as x⁻ⁿ and √x as x^(1/2) first."
    },
    "am": {
     "text": "xⁿ ን ለመዋጽኦ ኃይሉን ወደ ፊት አውርደን በ1 እንቀንሳለን፤ (xⁿ)′ = n xⁿ⁻¹። ለአሉታዊ ኃይሎችም ይሠራል።",
     "machine": true
    }
   },
