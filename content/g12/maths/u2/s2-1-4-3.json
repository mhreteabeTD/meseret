   "id": "math.sum-rule",
   "name": "Sum, difference and constant multiple rules",
   "requires": [
    "math.power-rule"
   ],
   "explain": {
    "en": {
     "text": "Differentiate a sum or difference term by term: (f ± g)′ = f′ ± g′. A constant factor stays: (kf)′ = kf′. So a polynomial is differentiated one term at a time, and a constant term gives 0. dy/dx at x = a means: differentiate first, then substitute."
    },
    "am": {
     "text": "ድምርን ወይም ልዩነትን በየተርሙ እንዋጽኦ፤ ቋሚ ቁጥር ይቀራል። ቋሚ ተርም 0 ይሰጣል።",
     "machine": true
    }
   },
   "screens": [
