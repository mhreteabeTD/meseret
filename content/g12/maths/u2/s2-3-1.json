  {
   "id": "math.riemann-sum",
   "name": "Riemann sums",
   "requires": [
    "math.sigma-notation"
   ],
   "explain": {
    "en": {
     "text": "To find the area under a curve, split [a, b] into n equal strips of width Δx = (b − a)/n. Use the height at each left endpoint, multiply by Δx and add: ∑ f(xᵢ)Δx. More, thinner rectangles give a better approximation. For an increasing function the left-endpoint sum is too small."
    },
    "am": {
     "text": "ከኩርባ ስር ያለውን ስፋት ለማግኘት [a, b] ን n እኩል ክፍሎች Δx = (b − a)/n አድርገን ∑ f(xᵢ)Δx እንደምራለን። ብዙ ቀጭን አራት ማዕዘኖች የተሻለ ግምት ይሰጣሉ።",
     "machine": true
    }
   },
   "screens": [
    {
     "kind": "guess",
     "step": "hook",
     "title": "Rectangles under a line",
     "ask": "Under y = 2x on [0, 6], rectangles of width 1 using left heights give 30, right heights give 42. The true area is",
     "opts": [
      "36",
      "30",
      "42",
      "72"
     ],
     "after": "The triangle has area (1/2)(6)(12) = 36: lower sum < area < upper sum.",
     "ref": "Activity 2.17 Q4–7",
     "id": "g12.maths.u2.s2-3-1.10"
    },
    {
     "kind": "read",
     "step": "read",
     "title": "Riemann sum",
     "paras": [
      "Divide [a, b] into n subintervals of width Δx = (b − a)/n.",
      "Area ≈ f(x₁)Δx + f(x₂)Δx + … + f(xₙ)Δx = ∑ f(xᵢ)Δx.",
      "In this book the height is taken at the left endpoint."
     ],
     "ref": "Definition 2.12, p.131–132",
     "id": "g12.maths.u2.s2-3-1.11"
    },
    {
     "kind": "slider",
     "step": "explore",
     "added": true,
     "title": "More rectangles",
     "ask": "f(x) = x² + 1 on [1, 5]. Change n. The exact area is 136/3 ≈ 45.33.",
     "vars": [
      {
       "k": "n",
       "label": "n (rectangles)",
       "min": 1,
       "max": 60,
       "step": 1,
       "v": 4
      }
     ],
     "formula": "Array.from({length: n}, (_, i) => { const x = 1 + i * 4 / n; return (x * x + 1) * 4 / n; }).reduce((s, v) => s + v, 0)",
     "out": "Left sum = {v}",
     "note": "n = 4 gives 34; n = 8 gives 39.5; the sum creeps up to 45.33.",
     "id": "g12.maths.u2.s2-3-1.12"
    },
    {
     "kind": "name",
     "step": "name",
     "title": "Key words",
     "defs": [
      [
       "Riemann sum",
       "An approximation ∑ f(xᵢ)Δx of the area under a curve using rectangles."
      ]
