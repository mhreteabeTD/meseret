 "ideas": [
  {
   "id": "math.ftc",
   "name": "Evaluating definite integrals",
   "requires": [
    "math.antiderivative"
   ],
   "explain": {
    "en": {
     "text": "To evaluate ∫ from a to b of f(x) dx: find any anti-derivative F (take C = 0), then compute F(b) − F(a). Write it as [F(x)] from a to b. The Fundamental Theorem says the area function A(x) has A′(x) = f(x). Be careful with signs when substituting a negative lower limit."
    },
    "am": {
     "text": "ዴፊኒት ኢንቲግራልን ለማስላት ማንኛውንም ፀረ-ዴሪቫቲቭ F አግኝተን F(b) − F(a) እናሰላለን።",
     "machine": true
    }
   },
