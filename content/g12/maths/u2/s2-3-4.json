 "ideas": [
  {
   "id": "math.signed-area",
   "name": "Area above and below the x-axis",
   "requires": [
    "math.ftc"
   ],
   "explain": {
    "en": {
     "text": "A definite integral counts area above the x-axis as positive and below as negative. For the true area, find where the graph crosses the axis, split the interval there, and add the absolute values: below the axis use −∫."
    },
    "am": {
     "text": "ዴፊኒት ኢንቲግራል ከ x-ዘንግ በላይ ያለውን አዎንታዊ፣ በታች ያለውን አሉታዊ ይቆጥራል። እውነተኛ ስፋት ለማግኘት በመቋረጫ ነጥቦቹ ከፍለን እንደምራለን።",
     "machine": true
    }
   },
   "screens": [
