{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meseret.et/schema/lesson.schema.json",
  "title": "Meseret lesson (one textbook section)",
  "type": "object",
  "required": [
    "id",
    "book",
    "title",
    "ideas",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^g(kg|[0-9]{1,2})\\.[a-z-]+\\.u[0-9]+\\.s[0-9]+(-[0-9]+)*$"
    },
    "book": {
      "type": "object",
      "required": [
        "title",
        "unit",
        "section"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "grade": {
          "type": "integer"
        },
        "subject": {
          "type": "string"
        },
        "unit": {
          "type": "integer"
        },
        "unit_title": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        }
      }
    },
    "title": {
      "type": "string"
    },
    "competency": {
      "type": "string"
    },
    "minutes": {
      "type": "integer"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "en",
          "def"
        ],
        "properties": {
          "en": {
            "type": "string"
          },
          "am": {
            "type": "string"
          },
          "om": {
            "type": "string"
          },
          "def": {
            "type": "string"
          },
          "machine": {
            "type": "boolean"
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "screens"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
          },
          "name": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explain": {
            "type": "object",
            "properties": {
              "en": {
                "$ref": "#/$defs/explain"
              },
              "am": {
                "$ref": "#/$defs/explain"
              },
              "om": {
                "$ref": "#/$defs/explain"
              }
            }
          },
          "video": {
            "type": "object",
            "required": [
              "yt",
              "lang",
              "seconds"
            ],
            "properties": {
              "yt": {
                "type": "string"
              },
              "lang": {
                "type": "string"
              },
              "seconds": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "mb": {
                "type": "number"
              }
            }
          },
          "screens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/screen"
            }
          },
          "tool": {
            "type": "string"
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "book_name",
          "items"
        ],
        "properties": {
          "book_name": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/screen"
            }
          }
        }
      }
    },
    "test": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "correction",
              "note",
              "review",
              "missing"
            ]
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "draft",
            "validated",
            "reviewed",
            "published"
          ]
        },
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "minutes": {
          "type": "integer"
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "tool": {
      "type": "string",
      "enum": [
        "factors"
      ]
    },
    "refreshers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "screens"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "screens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/screen"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "explain": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "audio": {
          "type": "string"
        },
        "seconds": {
          "type": "integer"
        },
        "machine": {
          "type": "boolean"
        }
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "kind",
        "step"
      ],
      "properties": {
        "kind": {
          "enum": [
            "guess",
            "tiles",
            "sort",
            "tap",
            "steps",
            "name",
            "mcq",
            "tf",
            "blank",
            "pick",
            "match",
            "order",
            "read",
            "picture",
            "gallery",
            "people",
            "reveal"
          ]
        },
        "step": {
          "enum": [
            "hook",
            "explore",
            "notice",
            "name",
            "method",
            "check",
            "practise",
            "exercise",
            "test",
            "read"
          ]
        },
        "id": {
          "type": "string"
        },
        "graded": {
          "type": "boolean"
        },
        "added": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "ask": {
          "type": "string"
        },
        "opts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ans": {
          "type": "string"
        },
        "a": {},
        "why": {
          "type": "string"
        },
        "clue": {
          "type": "string"
        },
        "worked": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "defs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array"
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          }
        },
        "figure": {
          "type": "object"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "need": {
          "type": "integer"
        },
        "pool": {
          "type": "array"
        },
        "needs": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "paras": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "read: paragraphs of book text, in order"
        },
        "table": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "read: a book table; first row is the header"
        },
        "note": {
          "type": "string",
          "description": "read: a small side note under the text"
        },
        "pic": {
          "type": "string",
          "description": "picture: id of a drawing in app/pictures.js"
        },
        "caption": {
          "type": "string"
        },
        "people": {
          "type": "array",
          "description": "people: [{name, years?, from?, did, img?}] img is an https Wikimedia Commons Special:FilePath URL",
          "items": {
            "type": "object",
            "required": [
              "name",
              "did"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "years": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "did": {
                "type": "string"
              },
              "img": {
                "type": "string"
              }
            }
          }
        },
        "answer": {
          "type": "string",
          "description": "reveal: the answer shown when the student taps Show answer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mcq"
              }
            }
          },
          "then": {
            "required": [
              "opts",
              "ans",
              "why",
              "clue"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tf"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "a",
              "why",
              "clue"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blank"
              }
            }
          },
          "then": {
            "required": [
              "ask",
              "a",
              "why",
              "clue"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sort"
              }
            }
          },
          "then": {
            "required": [
              "bins",
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "match"
              }
            }
          },
          "then": {
            "required": [
              "pairs",
              "why"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "order"
              }
            }
          },
          "then": {
            "required": [
              "items",
              "why"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "name"
              }
            }
          },
          "then": {
            "required": [
              "defs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "steps"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tap"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pick"
              }
            }
          },
          "then": {
            "required": [
              "pool",
              "a",
              "why"
            ]
          }
        }
      ]
    }
  }
}
